#!/bin/sh
# release -- tag the commit this checkout is at as jobber-host's next release,
# v<Cargo.toml version>-<n>, and push the tag to origin. The pipeline's
# deploy-prod job (`release` in its routine's jobs.toml, dakotacolorado/
# release-routines dakotacolorado/jobber-host/); a computer installs from the tag.
#
#   scripts/release             tag and push, then print `deployed: <commit>`
#   scripts/release --dry-run   say which tag it would push, and push nothing
#
# A commit that a v<version>-* tag already names is not tagged again: it is
# that release, so a rerun reports it. With GH_TOKEN set (the job's `github`
# credential) git authenticates to GitHub with it; the token is never printed.
set -eu

say() { echo "release: $*"; }
dry=""
case ${1-} in
"") ;;
--dry-run) dry=1 ;;
*) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

cd "$(dirname "$0")/.."

git() {
  if [ -n "${GH_TOKEN-}" ]; then
    # An empty helper first clears any the user's config adds.
    command git -c credential.helper= \
      -c 'credential.helper=!f() { test "$1" = get && printf "username=x-access-token\npassword=%s\n" "$GH_TOKEN"; }; f' "$@"
  else
    command git "$@"
  fi
}

[ -z "$(git status --porcelain)" ] || { say "the checkout has uncommitted changes: a release is a commit" >&2; exit 1; }
commit=$(git rev-parse HEAD)
version=$(sed -n '/^\[package\]/,/^\[/s/^version *= *"\([^"]*\)".*/\1/p' Cargo.toml)
[ -n "$version" ] || { say "no version in Cargo.toml's [package]" >&2; exit 1; }

# Every v<version>-<n> tag on origin, peeled to its commit: "<commit> <n>".
# Not piped: sh has no pipefail, and a failed ls-remote must not read as no tags.
remote=$(git ls-remote --tags origin "refs/tags/v$version-*") || { say "could not list origin's tags" >&2; exit 1; }
tags=$(printf '%s\n' "$remote" |
  sed -n "s#^\([0-9a-f]*\)\trefs/tags/v$version-\([0-9][0-9]*\)\(^{}\)\{0,1\}\$#\1 \2#p")

existing=$(printf '%s\n' "$tags" | awk -v c="$commit" '$1 == c { print $2; exit }')
if [ -n "$existing" ]; then
  say "$commit is already v$version-$existing"
  [ -n "$dry" ] || echo "deployed: $commit"
  exit 0
fi

n=$(printf '%s\n' "$tags" | awk 'BEGIN { m = 0 } $2 + 0 > m { m = $2 + 0 } END { print m + 1 }')
tag="v$version-$n"
if [ -n "$dry" ]; then
  say "would tag $commit as $tag and push it to origin"
  exit 0
fi
say "tagging $commit as $tag"
git push -q origin "$commit:refs/tags/$tag"
say "pushed $tag: a computer installs it with scripts/install.sh from a checkout of it"
echo "deployed: $commit"
